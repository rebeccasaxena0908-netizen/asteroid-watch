# Copy this file to .env and fill in real values. Never commit .env.

# NASA API key from https://api.nasa.gov
NASA_API_KEY=your_key_here

# MySQL (XAMPP / MariaDB)
# If DB_SOCKET is set, it is used instead of host/port.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
DB_USER=asteroid_user
DB_PASSWORD=change_me
DB_NAME=asteroid_watch

# Read-only MySQL user for the PHP dashboard (created by make setup-db)
DASHBOARD_DB_USER=asteroid_reader
DASHBOARD_DB_PASSWORD=change_me
